<UserControl x:Class="unity_cli_ui.Controls.AboutPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{DynamicResource Card}" Margin="0,14,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#F0F2F5"
                    BorderBrush="#DFE4EB"
                    BorderThickness="1">
                <Image Source="/Assets/AppLogo.ico" Width="24" Height="24" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{DynamicResource about.title}"
                           Style="{DynamicResource SectionTitle}" />
                <TextBlock Text="Unity CLIUI"
                           Margin="0,4,0,0"
                           Foreground="#354056"
                           FontSize="13"
                           FontWeight="SemiBold" />

                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource about.version}"
                               Foreground="#647087"
                               FontSize="11" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProductVersion, ElementName=Root, Mode=OneWay}"
                               Foreground="#354056"
                               FontSize="11" />

                    <TextBlock Grid.Row="2"
                               Text="{DynamicResource about.repository}"
                               Foreground="#647087"
                               FontSize="11" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RepositoryUrl, ElementName=Root, Mode=OneWay}">
                        <Hyperlink NavigateUri="{Binding RepositoryUri, ElementName=Root, Mode=OneWay}"
                                   RequestNavigate="Repository_RequestNavigate"
                                   Foreground="#0078D4">
                            <Run Text="{Binding RepositoryUrl, ElementName=Root, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
