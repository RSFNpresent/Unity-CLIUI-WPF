<Window x:Class="unity_cli_ui.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource firstRun.title}"
        Icon="Assets/AppLogo.ico"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#0078D4" />

        <Style x:Key="SetupChoiceRadio" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8CCD2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="ChoiceRing"
                                             Fill="White"
                                             Stroke="#6B6B6B"
                                             StrokeThickness="1" />
                                    <Ellipse x:Name="ChoiceDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{StaticResource DialogAccentBrush}"
                                             Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#F2F2F2" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#8A8886" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="#E5F1FB" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                <Setter TargetName="ChoiceRing" Property="Stroke" Value="{StaticResource DialogAccentBrush}" />
                                <Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="BorderBrush" Value="#C8CCD2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="#E1E4E8"
                BorderThickness="0,0,0,1"
                Padding="24,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource firstRun.heading}"
                           Foreground="#172033"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource firstRun.description}"
                           Margin="0,7,0,0"
                           Foreground="#647087"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="{DynamicResource firstRun.language}"
                       Foreground="#303846"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,9" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="ChineseLanguageRadio"
                             GroupName="Language"
                             Tag="zh-CN"
                             Style="{StaticResource SetupChoiceRadio}"
                             Checked="Language_Checked">
                    <TextBlock Text="简体中文" FontSize="12" />
                </RadioButton>
                <RadioButton x:Name="EnglishLanguageRadio"
                             Grid.Column="2"
                             GroupName="Language"
                             Tag="en-US"
                             Style="{StaticResource SetupChoiceRadio}"
                             Checked="Language_Checked">
                    <TextBlock Text="English" FontSize="12" />
                </RadioButton>
            </Grid>

            <TextBlock Text="{DynamicResource firstRun.managementMode}"
                       Foreground="#303846"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,20,0,9" />
            <RadioButton x:Name="CliModeRadio"
                         GroupName="ManagementMode"
                         Tag="UnityCli"
                         MinHeight="72"
                         Style="{StaticResource SetupChoiceRadio}"
                         Checked="ManagementMode_Checked">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings.mode.cli}"
                               Foreground="#202020"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource firstRun.cliHint}"
                               Margin="0,4,0,0"
                               Foreground="#647087"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="DirectModeRadio"
                         GroupName="ManagementMode"
                         Tag="Direct"
                         MinHeight="72"
                         Margin="0,8,0,0"
                         Style="{StaticResource SetupChoiceRadio}"
                         Checked="ManagementMode_Checked">
                <StackPanel>
                    <TextBlock Text="{DynamicResource status.direct.label}"
                               Foreground="#202020"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource firstRun.directHint}"
                               Margin="0,4,0,0"
                               Foreground="#647087"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border Grid.Row="2"
                Background="#F3F3F3"
                BorderBrush="#E1E4E8"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource firstRun.exit}"
                        Style="{StaticResource DialogButton}"
                        IsCancel="True"
                        Click="Exit_Click" />
                <Button x:Name="ContinueButton"
                        Content="{DynamicResource firstRun.continue}"
                        Style="{StaticResource DialogPrimaryButton}"
                        Margin="10,0,0,0"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Continue_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
