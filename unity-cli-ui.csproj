<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Unity-CLIUI</AssemblyName>
    <RootNamespace>unity_cli_ui</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <InformationalVersion>1.0.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Unity CLIUI</Product>
    <Company>RSFNpresent</Company>
    <ApplicationIcon>Assets\AppLogo.ico</ApplicationIcon>
    <RepositoryUrl>https://github.com/RSFNpresent/Unity-CLIUI-WPF</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NuGetAudit>false</NuGetAudit>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="unitycli-*.exe" />
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="unitycli-*.exe" />
    <Resource Include="Assets\AppLogo.ico" />
    <None Remove="Resources\Strings.*.json" />
    <Resource Include="Resources\Strings.*.json" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="MainWindow.xaml.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="ValidatePublishedLayout" AfterTargets="Publish">
    <ItemGroup>
      <_UnexpectedPublishedFile Include="$(PublishDir)**\*"
                                Exclude="$(PublishDir)$(AssemblyName).exe" />
    </ItemGroup>
    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).exe')"
           Text="Publish output is missing $(AssemblyName).exe." />
    <Error Condition="'@(_UnexpectedPublishedFile)' != ''"
           Text="Publish output must contain only $(AssemblyName).exe. Unexpected files: @(_UnexpectedPublishedFile, ', ')" />
  </Target>

</Project>
