<Window x:Class="unity_cli_ui.InstallEditorConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource dialog.installConfirm.title}"
        Width="620"
        Height="382"
        MinWidth="560"
        MinHeight="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F8FA"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#D7DCE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F0F2F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E5E8ED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="BorderBrush" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5E6A7E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
    </Window.Resources>

    <Border Background="#F7F8FA" BorderBrush="#D9DEE8" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource dialog.installConfirm.heading}"
                           Foreground="#202B3E"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="#5E6A7E"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,9,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E1E5EB"
                    BorderThickness="1"
                    Padding="14"
                    Margin="0,18,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource dialog.installConfirm.version}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Version}"
                                   Foreground="#202B3E"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{DynamicResource dialog.installConfirm.modules}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ModuleText}"
                                   Foreground="#202B3E"
                                   TextWrapping="Wrap"
                                   MaxHeight="42" />
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{DynamicResource dialog.installConfirm.installDirectory}"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding InstallDirectory, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Height="34"
                                 Padding="9,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="#202B3E"
                                 Background="#FBFCFE"
                                 BorderBrush="#DDE2EA"
                                 BorderThickness="1" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{DynamicResource dialog.installConfirm.modifyDirectory}"
                        Style="{StaticResource DialogButton}"
                        Click="ModifyDirectory_Click" />
                <Button Content="{DynamicResource common.cancel}"
                        Style="{StaticResource DialogButton}"
                        Margin="8,0,0,0"
                        IsCancel="True" />
                <Button Content="{DynamicResource common.ok}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
